const LEARNING_MATERIALS_ = Object.freeze({
  'CH08-01-U01':material_([
    ['Sel dan kehidupan','Sel merupakan satuan terkecil yang masih mampu menjalankan ciri kehidupan. Organisme bersel satu melakukan seluruh fungsi hidup dalam satu sel, sedangkan organisme multisel tersusun atas banyak sel yang berbagi tugas.'],
    ['Mengapa perlu mikroskop?','Kebanyakan sel berukuran sangat kecil. Mikroskop memperbesar bayangan sehingga bentuk umum sel dapat diamati, tetapi gambar yang besar belum tentu memperlihatkan detail yang lebih tajam.'],
    ['Teori sel','Makhluk hidup tersusun atas satu atau lebih sel, sel adalah unit dasar struktur dan fungsi kehidupan, dan sel baru berasal dari sel yang telah ada.'],
    ['Mengapa konsep sel bermanfaat?','Konsep sel membantu menjelaskan pertumbuhan, penyembuhan luka, pewarisan sifat, serta penyakit yang bermula dari gangguan kerja sel. Mikroskop juga digunakan untuk memeriksa jaringan dan mikroorganisme.']
  ],'Saat kulit terluka, sel-sel baru terbentuk untuk mengganti bagian yang rusak.','Sel bukan benda mati seperti batu bata. Di dalamnya berlangsung pertukaran zat, penggunaan energi, pertumbuhan, dan tanggapan terhadap lingkungan.','Tuliskan tiga alasan mengapa sel disebut unit kehidupan.','Okky Fajar Tri Maryana dkk., Ilmu Pengetahuan Alam untuk SMP Kelas VIII (2021), Bab 1; Anni Winarsih dkk., IPA Terpadu SMP/MTs Kelas VII (2008), Bab 13','Pusat Perbukuan Kemendikbudristek, hlm. 1-26; Pusat Perbukuan Depdiknas, hlm. 271-289. Materi diringkas dan dipadukan'),
  'CH08-01-U02':material_([
    ['Bagian yang dimiliki bersama','Sel hewan dan tumbuhan memiliki membran sel, sitoplasma, inti sel, mitokondria, dan ribosom. Setiap bagian membantu sel melakukan tugas tertentu.'],
    ['Ciri sel tumbuhan','Dinding sel memberi bentuk lebih tetap, kloroplas menangkap energi cahaya untuk fotosintesis, dan vakuola besar menyimpan air serta zat terlarut.'],
    ['Bentuk mengikuti fungsi','Sel tidak selalu berbentuk bulat. Bentuk memanjang pada sel saraf membantu penghantaran pesan, sedangkan sel darah merah berbentuk pipih untuk mendukung pengangkutan gas.'],
    ['Kerja sama organel','Inti mengatur banyak kegiatan sel, membran mengatur pertukaran, dan mitokondria membantu menyediakan energi. Pada tumbuhan, kloroplas membuat bahan makanan yang kemudian dapat digunakan sel.']
  ],'Daun tampak hijau karena banyak selnya mengandung kloroplas berpigmen klorofil.','Sel hewan juga memiliki vakuola kecil pada kondisi tertentu; perbedaan tidak boleh disederhanakan menjadi ada atau tidak ada vakuola saja.','Buat tabel dua kolom yang membandingkan sel hewan dan sel tumbuhan.','Okky Fajar Tri Maryana dkk., Ilmu Pengetahuan Alam untuk SMP Kelas VIII (2021), Bab 1; Anni Winarsih dkk., IPA Terpadu SMP/MTs Kelas VII (2008), Bab 13','Pusat Perbukuan, hlm. 11-20 dan hlm. 275-282. Nama dan fungsi organel disederhanakan untuk tingkat SMP'),
  'CH08-01-U03':material_([
    ['Dari sel menuju jaringan','Sel-sel dengan bentuk dan tugas yang serupa bekerja bersama membentuk jaringan, misalnya jaringan otot dan jaringan pengangkut pada tumbuhan.'],
    ['Dari jaringan menuju organ','Beberapa jaringan menyusun organ. Lambung, misalnya, memiliki jaringan otot, epitel, saraf, dan jaringan ikat yang bekerja sebagai satu kesatuan.'],
    ['Sistem organ dan organisme','Organ yang saling mendukung membentuk sistem organ. Seluruh sistem organ yang terkoordinasi membentuk satu organisme.'],
    ['Manfaat memahami tingkatan','Urutan organisasi membantu kita menelusuri akibat gangguan. Kerusakan sel otot dapat memengaruhi jaringan otot, kerja organ, gerak sistem tubuh, lalu aktivitas organisme.']
  ],'Gerakan tangan melibatkan tulang, otot, saraf, pembuluh darah, dan sistem pernapasan yang bekerja bersama.','Urutan organisasi bukan sekadar urutan ukuran; tiap tingkat mempunyai fungsi yang muncul dari kerja sama bagian-bagiannya.','Gambar urutan sel - jaringan - organ - sistem organ - organisme beserta satu contoh.','Anni Winarsih dkk., IPA Terpadu SMP/MTs Kelas VII (2008), Bab 13 Sistem Organisasi Kehidupan','Pusat Perbukuan Depdiknas, hlm. 271-289, khususnya urutan sel-jaringan-organ-sistem organ-organisme'),
  'CH08-02-U01':material_([
    ['Tingkat organisasi tubuh','Sel sejenis bekerja sama membentuk jaringan. Beberapa jaringan menyusun organ, organ-organ yang berhubungan membentuk sistem organ, dan seluruh sistem organ membentuk tubuh manusia. Bentuk jaringan dan organ berkaitan dengan tugasnya.'],
    ['Tubuh sebagai kesatuan','Tubuh manusia tersusun atas sistem organ yang saling bertukar bahan dan informasi. Gangguan pada satu sistem dapat mengubah kerja sistem lainnya.'],
    ['Masukan, pengangkutan, penggunaan, dan keluaran','Pencernaan menyediakan zat makanan, pernapasan menyediakan oksigen, peredaran darah mengangkut keduanya menuju sel, dan sistem ekskresi membantu mengeluarkan zat sisa metabolisme.'],
    ['Koordinasi dan homeostasis','Sistem saraf dan hormon membantu mengatur kerja organ. Tubuh menjaga suhu, air, gas, gula darah, dan zat terlarut dalam kisaran yang mendukung kerja sel; kestabilan dinamis ini disebut homeostasis.'],
    ['Mengamati struktur dan fungsi','Preparat jaringan, model organ, tabel, dan diagram alir merupakan bukti atau model untuk menghubungkan bentuk dengan fungsi. Model membantu belajar, tetapi tidak selalu menunjukkan ukuran, warna, dan gerak sebenarnya.'],
    ['Gangguan sebagai masalah sistem','Sesak, lelah, pusing, nyeri, atau perubahan buang air dapat berkaitan dengan banyak keadaan. Penjelasan ilmiah perlu membandingkan bukti dan hubungan antarsistem, bukan menebak diagnosis dari satu gejala.']
  ],'Saat berlari, napas dan denyut jantung meningkat, aliran darah ke otot bertambah, dan kulit membantu mengatur suhu karena kebutuhan sel berubah.','Tidak ada satu sistem yang sepenuhnya bekerja sendiri; pembagian sistem dibuat agar hubungan yang rumit lebih mudah dipelajari.','Gambar alur oksigen dari udara sampai ke sel otot, lalu tulis sistem organ yang terlibat pada setiap tahap.','Okky Fajar Tri Maryana dkk., Ilmu Pengetahuan Alam untuk SMP Kelas VIII (2021), Bab 2 Struktur dan Fungsi Tubuh Makhluk Hidup','Pusat Perbukuan Kemendikbudristek, hlm. 27-82. Bagian ini menyintesis hubungan sistem tubuh sesuai CP 1.1.3 dan ATP 8.1.1.3',{
    cp_target:'CP 1.1.3 / ATP 8.1.1.3: menganalisis organisasi kehidupan, fungsi organ, hubungan sistem, serta gangguannya.',
    learning_goals:['Menjelaskan urutan sel-jaringan-organ-sistem organ-organisme.','Menghubungkan bentuk atau bagian organ dengan fungsinya.','Menjelaskan mengapa perubahan pada satu sistem dapat memengaruhi sistem lain.'],
    glossary:[['Homeostasis','pemeliharaan keadaan internal tubuh dalam kisaran yang sesuai'],['Metabolisme','seluruh reaksi kimia yang berlangsung di dalam tubuh'],['Sistem organ','kelompok organ yang bekerja sama menjalankan fungsi tertentu']],
    enrichment:'Amati perubahan denyut nadi dan frekuensi napas sebelum serta setelah aktivitas ringan. Sajikan data dalam tabel dan jelaskan hubungan antarsistem tanpa menjadikannya diagnosis kesehatan.'
  }),
  'CH08-02-U02':material_([
    ['Mengapa tubuh memerlukan makanan?','Makanan menyediakan energi, bahan pembangun dan perbaikan jaringan, serta zat pengatur. Energi makanan dinyatakan dalam kilokalori (kkal). Kebutuhan setiap orang tidak sama karena dipengaruhi usia, pertumbuhan, aktivitas, dan kondisi tubuh.'],
    ['Karbohidrat, protein, dan lemak','Karbohidrat merupakan sumber energi utama; protein membangun dan memperbaiki jaringan serta membentuk enzim; lemak menjadi cadangan energi, pelindung organ, dan membantu penyerapan vitamin tertentu. Setiap gram karbohidrat atau protein menghasilkan sekitar 4 kkal, sedangkan lemak sekitar 9 kkal.'],
    ['Vitamin, mineral, air, dan serat','Vitamin dan mineral diperlukan dalam jumlah kecil untuk membantu berbagai proses tubuh. Air menjadi pelarut, pengangkut, dan pengatur suhu. Serat tidak dicerna menjadi energi, tetapi membantu gerak usus dan kesehatan pencernaan. Kekurangan maupun kelebihan zat gizi dapat mengganggu kesehatan.'],
    ['Sumber pangan beragam','Nasi, jagung, sagu, kentang, dan umbi merupakan contoh sumber karbohidrat. Ikan, telur, daging, susu, kacang, tempe, dan tahu menyediakan protein. Sayur dan buah menyumbang serat, vitamin, mineral, dan air. Tidak ada satu bahan makanan yang memenuhi seluruh kebutuhan tubuh.'],
    ['Gizi seimbang dan label kemasan','Pedoman Isi Piringku menekankan makanan pokok, lauk berprotein, sayur, dan buah dalam porsi seimbang, disertai cukup air, aktivitas fisik, kebersihan, serta pembatasan makanan terlalu manis, asin, dan berlemak. Label Informasi Nilai Gizi membantu membandingkan takaran saji, energi, gula, garam atau natrium, lemak, dan protein.'],
    ['Pencernaan mekanis dan kimiawi','Gigi, lidah, dan gerak otot memperkecil serta mendorong makanan secara mekanis. Enzim memecah molekul besar secara kimiawi: amilase bekerja pada pati, protease pada protein, dan lipase pada lemak. Enzim bekerja khusus dan tidak mengubah semua zat makanan.'],
    ['Jalur dan fungsi organ','Makanan bergerak melalui mulut, kerongkongan, lambung, usus halus, usus besar, rektum, lalu anus. Hati menghasilkan empedu yang membantu pengolahan lemak, pankreas menghasilkan enzim pencernaan, dan gerak peristaltik mendorong makanan di sepanjang saluran.'],
    ['Penyerapan dan pengeluaran sisa','Sebagian besar zat makanan diserap melalui jonjot usus halus menuju darah atau limfa. Usus besar menyerap kembali sebagian air dan menjadi tempat pembentukan feses sebelum dikeluarkan. Pengeluaran feses bukan ekskresi karena feses terutama berisi sisa yang tidak tercerna.'],
    ['Gangguan dan pencegahan','Karies dapat berkaitan dengan kebersihan gigi dan konsumsi gula; diare dapat menyebabkan kehilangan air; sembelit berkaitan antara lain dengan kurang serat, cairan, atau aktivitas. Makanan bersih, pola makan beragam, cuci tangan, serta pertolongan tenaga kesehatan saat gejala berat membantu menjaga sistem pencernaan.']
  ],'Pada label kemasan tertulis 120 kkal per sajian dan terdapat dua sajian. Jika seluruh isi dimakan, energi yang masuk sekitar 240 kkal. Perhatikan bahwa "per sajian" berbeda dari "per kemasan".','Makanan tidak otomatis sehat hanya karena mengandung satu vitamin, dan pencernaan tidak hanya berlangsung di lambung. Nilai makanan ditentukan oleh komposisi, jumlah, kebersihan, dan pola konsumsi keseluruhan.','Buat tabel zat gizi berisi fungsi, dua sumber pangan lokal, dan akibat umum bila asupannya tidak seimbang; lanjutkan dengan alur organ pencernaan beserta proses utamanya.','Okky Fajar Tri Maryana dkk., Ilmu Pengetahuan Alam untuk SMP Kelas VIII (2021), Bab 2A; Saeful Karim dkk., Belajar IPA 2 (2008), Bab 3; Kementerian Kesehatan RI, Isi Piringku (2024)','Pusat Perbukuan, hlm. 28-53 dan hlm. 37-54; materi gizi seimbang diselaraskan dengan panduan Kementerian Kesehatan. Cakupan meliputi nutrisi, energi, label, organ, enzim, penyerapan, dan gangguan',{
    cp_target:'CP 1.1.3 / ATP 8.1.1.3: mendeskripsikan fungsi organ dan contoh gangguan pada sistem pencernaan.',
    learning_goals:['Mengelompokkan zat gizi menurut fungsi dan sumbernya.','Membaca takaran saji dan informasi penting pada label pangan.','Menjelaskan pencernaan mekanis, kimiawi, jalur organ, dan penyerapan.','Menghubungkan gangguan pencernaan dengan pencegahan yang masuk akal.'],
    glossary:[['Nutrien atau zat gizi','zat dalam makanan yang diperlukan tubuh'],['Enzim','protein yang membantu mempercepat reaksi kimia tertentu'],['Peristaltik','gerak bergelombang otot saluran pencernaan'],['Vili atau jonjot usus','lipatan kecil yang memperluas permukaan penyerapan usus halus']],
    enrichment:'Gunakan satu label makanan kemasan. Hitung energi jika dikonsumsi setengah, satu, dan seluruh kemasan; lalu bandingkan gula, natrium, lemak, dan protein per sajian. Pengayaan ini tidak menjadi syarat membuka materi berikutnya.'
  }),
  'CH08-02-U03':material_([
    ['Fungsi sistem peredaran','Sistem peredaran mengangkut oksigen, karbon dioksida, zat makanan, hormon, panas, dan sisa metabolisme. Sistem ini juga membantu pertahanan tubuh, pembekuan darah, dan kestabilan suhu.'],
    ['Komponen darah','Plasma membawa air dan zat terlarut. Sel darah merah dengan hemoglobin mengangkut banyak oksigen, sel darah putih membantu pertahanan, dan keping darah membantu pembekuan. Bentuk serta jumlah setiap komponen mendukung fungsinya.'],
    ['Jantung sebagai pompa','Jantung memiliki serambi dan bilik kanan-kiri. Katup membantu menjaga aliran satu arah. Sisi kanan mengirim darah ke paru-paru, sedangkan sisi kiri memompa darah beroksigen ke seluruh tubuh. Otot bilik kiri lebih tebal karena tekanannya lebih besar.'],
    ['Arteri, vena, dan kapiler','Arteri membawa darah meninggalkan jantung dan berdinding kuat; vena mengembalikan darah serta banyak yang memiliki katup; kapiler sangat tipis sehingga memungkinkan pertukaran zat dengan jaringan. Nama pembuluh ditentukan oleh arah aliran, bukan kadar oksigennya.'],
    ['Peredaran ganda','Peredaran kecil mengikuti jalur jantung-paru-paru-jantung. Peredaran besar mengikuti jalur jantung-seluruh tubuh-jantung. Dalam satu putaran lengkap, darah melewati jantung dua kali sehingga manusia memiliki peredaran ganda.'],
    ['Denyut dan tekanan darah','Denyut nadi mengikuti kontraksi jantung, sedangkan tekanan darah menunjukkan gaya darah pada dinding pembuluh. Aktivitas biasanya menaikkan kebutuhan oksigen sehingga denyut berubah. Data harus diukur dengan cara yang sama dan tidak boleh dipakai siswa untuk mendiagnosis penyakit.'],
    ['Gangguan dan pemeliharaan','Anemia mengurangi kemampuan darah membawa oksigen; hipertensi adalah tekanan darah yang menetap tinggi; aterosklerosis menyempitkan pembuluh karena penumpukan plak dan dapat meningkatkan risiko penyakit jantung. Aktivitas fisik, pola makan seimbang, tidur cukup, serta menghindari rokok membantu menurunkan risiko.']
  ],'Sesudah aktivitas ringan, denyut nadi umumnya meningkat lalu berangsur mendekati keadaan awal ketika beristirahat. Pola perubahan lebih bermakna daripada membandingkan satu angka antarsiswa.','Arteri tidak selalu membawa darah kaya oksigen dan vena tidak selalu membawa darah miskin oksigen; pembuluh paru merupakan contoh penting.','Gambar dua jalur peredaran darah dan buat tabel perbandingan komponen darah serta tiga jenis pembuluh.','Okky Fajar Tri Maryana dkk., Ilmu Pengetahuan Alam untuk SMP Kelas VIII (2021), Bab 2B; Saeful Karim dkk., Belajar IPA 2 (2008), Bab 5','Pusat Perbukuan, hlm. 54-64 dan hlm. 69-82. Cakupan meliputi darah, jantung, pembuluh, peredaran ganda, pembacaan data, gangguan, dan pencegahan',{
    cp_target:'CP 1.1.3 / ATP 8.1.1.3: mendeskripsikan fungsi organ dan contoh gangguan pada sistem peredaran darah.',
    learning_goals:['Menjelaskan fungsi komponen darah, jantung, dan pembuluh.','Menelusuri peredaran kecil dan besar.','Menafsirkan perubahan denyut atau grafik sederhana.','Menjelaskan contoh gangguan dan upaya pengurangan risiko.'],
    glossary:[['Hemoglobin','protein pada sel darah merah yang mengikat oksigen'],['Katup','struktur yang membantu mencegah aliran balik'],['Aterosklerosis','penyempitan pembuluh akibat penumpukan plak']],
    enrichment:'Ubah data denyut sebelum, sesudah aktivitas, dan sesudah pemulihan menjadi grafik garis. Jelaskan pola, variabel yang dikendalikan, dan keterbatasan datanya.'
  }),
  'CH08-02-U04':material_([
    ['Fungsi pernapasan','Sistem pernapasan melakukan ventilasi dan pertukaran gas. Oksigen diperlukan sel dalam pelepasan energi dari zat makanan, sedangkan karbon dioksida hasil metabolisme perlu dikeluarkan.'],
    ['Jalur udara dan perlindungan','Udara melewati hidung, faring, laring, trakea, bronkus, bronkiolus, dan mencapai alveolus. Rambut hidung, lendir, dan silia membantu menangkap partikel; hidung juga menghangatkan serta melembapkan udara.'],
    ['Mekanisme inspirasi','Ketika diafragma berkontraksi dan mendatar serta otot antartulang rusuk membantu mengangkat rusuk, volume rongga dada bertambah. Tekanan dalam paru menurun sehingga udara bergerak masuk.'],
    ['Mekanisme ekspirasi','Saat otot pernapasan relaksasi, volume rongga dada berkurang dan tekanan meningkat sehingga udara keluar. Pada hembusan kuat, otot tambahan dapat ikut bekerja. Udara masuk dan keluar karena perbedaan tekanan.'],
    ['Pertukaran gas di alveolus','Alveolus berjumlah banyak, berdinding tipis, lembap, dan dikelilingi kapiler sehingga luas permukaan pertukaran besar. Oksigen berdifusi ke darah, sedangkan karbon dioksida berdifusi menuju alveolus.'],
    ['Frekuensi napas dan data','Aktivitas, usia, suhu, posisi tubuh, dan keadaan emosi dapat memengaruhi frekuensi napas. Perbandingan data harus memakai durasi, aktivitas, dan cara hitung yang sama serta mempertimbangkan variasi antarindividu.'],
    ['Gangguan dan paparan','Asma menyempitkan saluran napas karena peradangan dan kepekaan tertentu; bronkitis melibatkan peradangan bronkus; emfisema merusak alveolus. Asap rokok mengandung berbagai zat berbahaya dan juga meningkatkan risiko bagi perokok pasif. Gejala berat atau menetap memerlukan pemeriksaan tenaga kesehatan.'],
    ['Menjaga sistem pernapasan','Menghindari rokok dan pembakaran sampah, menjaga ventilasi, mengurangi debu, menggunakan pelindung sesuai kebutuhan, serta beraktivitas fisik secara aman membantu menjaga pernapasan. Pencegahan paparan lebih penting daripada sekadar menghafal nama penyakit.']
  ],'Frekuensi napas meningkat setelah aktivitas karena kebutuhan oksigen dan produksi karbon dioksida sel berubah. Setelah istirahat, nilainya biasanya menurun menuju keadaan awal.','Bernapas bukan hanya memasukkan oksigen. Ventilasi adalah gerak udara, pertukaran gas adalah difusi di alveolus, dan respirasi sel berlangsung di dalam sel.','Buat diagram jalur udara dan jelaskan hubungan gerak diafragma, volume rongga dada, tekanan, serta arah udara saat inspirasi dan ekspirasi.','Okky Fajar Tri Maryana dkk., Ilmu Pengetahuan Alam untuk SMP Kelas VIII (2021), Bab 2C; Saeful Karim dkk., Belajar IPA 2 (2008), Bab 4','Pusat Perbukuan, hlm. 65-75 dan hlm. 57-68. Cakupan meliputi organ, ventilasi, alveolus, data frekuensi, gangguan, rokok, dan pencegahan',{
    cp_target:'CP 1.1.3 / ATP 8.1.1.3: mendeskripsikan fungsi organ dan contoh gangguan pada sistem pernapasan.',
    learning_goals:['Menelusuri jalur udara dan fungsi setiap bagian utama.','Menjelaskan ventilasi dengan hubungan volume, tekanan, dan gerak otot.','Menjelaskan pertukaran gas di alveolus.','Menilai pengaruh paparan dan cara menjaga kesehatan pernapasan.'],
    glossary:[['Ventilasi','proses keluar-masuknya udara dari dan ke paru-paru'],['Difusi','perpindahan partikel dari daerah berkonsentrasi tinggi ke rendah'],['Alveolus','kantung udara kecil tempat pertukaran gas']],
    enrichment:'Bandingkan frekuensi napas saat duduk dan setelah aktivitas ringan yang aman. Sajikan data kelompok, cari rentang, dan jelaskan mengapa hasil setiap orang tidak harus sama.'
  }),
  'CH08-02-U05':material_([
    ['Ekskresi, sekresi, dan defekasi','Ekskresi mengeluarkan zat sisa metabolisme, sekresi menghasilkan zat yang masih digunakan tubuh seperti enzim atau hormon, sedangkan defekasi mengeluarkan sisa makanan yang tidak tercerna. Ketiganya berbeda walaupun sama-sama melibatkan keluarnya bahan.'],
    ['Zat sisa dan organ ekskresi','Ginjal mengeluarkan urea, kelebihan air, dan garam melalui urine; paru-paru mengeluarkan karbon dioksida dan uap air; kulit mengeluarkan keringat; hati mengolah zat berbahaya, membentuk urea, dan menghasilkan pigmen empedu dari perombakan sel darah merah.'],
    ['Ginjal dan nefron','Setiap ginjal tersusun atas banyak nefron sebagai unit kerja. Glomerulus dan kapsul Bowman melakukan penyaringan awal, sedangkan saluran nefron mengambil kembali zat yang diperlukan dan menambahkan sebagian zat sisa.'],
    ['Tiga tahap pembentukan urine','Filtrasi menyaring sebagian plasma darah; reabsorpsi mengambil kembali air, glukosa, ion, dan zat lain yang masih diperlukan; sekresi atau augmentasi menambahkan zat tertentu ke saluran. Urine normal terutama berisi air, urea, serta garam terlarut.'],
    ['Jalur urine dan keseimbangan air','Urine mengalir dari ginjal melalui ureter, disimpan di kandung kemih, lalu keluar melalui uretra. Ginjal menyesuaikan banyaknya air dan ion yang dikeluarkan sehingga membantu menjaga volume serta komposisi cairan tubuh.'],
    ['Kulit, paru-paru, dan hati','Keringat membantu pengeluaran air dan garam sekaligus pengaturan suhu. Paru-paru berhubungan erat dengan peredaran dalam membuang karbon dioksida. Hati mengolah zat dari pencernaan dan darah sebelum sebagian sisanya dikeluarkan melalui ginjal atau empedu.'],
    ['Gangguan dan penanganan','Batu ginjal dapat menghambat saluran urine, nefritis mengganggu penyaringan, dan gagal ginjal menurunkan kemampuan menjaga komposisi darah. Dialisis dapat menggantikan sebagian fungsi penyaringan, tetapi bukan menyembuhkan semua penyebab. Diagnosis harus dilakukan tenaga kesehatan.'],
    ['Menjaga organ ekskresi','Cukup minum sesuai kebutuhan, tidak menahan buang air kecil, menjaga kebersihan, makan seimbang, serta tidak menggunakan obat atau suplemen sembarangan membantu mengurangi risiko. Kondisi tertentu memerlukan anjuran cairan khusus dari tenaga kesehatan.']
  ],'Urine yang lebih pekat dapat terjadi saat tubuh kekurangan air karena ginjal mengambil kembali lebih banyak air. Namun warna saja tidak cukup untuk menentukan penyakit.','Ginjal bukan saringan pasif seperti kain; filtrasi, reabsorpsi, dan sekresi merupakan proses selektif. Keringat juga bukan "racun" yang harus dipaksa keluar sebanyak-banyaknya.','Bedakan ekskresi, sekresi, dan defekasi; lalu gambar nefron sederhana dan jelaskan tiga tahap pembentukan urine.','Dewi Ganawati, Sudarmana, dan Wiwik Radyuni, Pembelajaran IPA Terpadu dan Kontekstual IX (2008), Bab 1; Okky Fajar Tri Maryana dkk., IPA VIII (2021), Bab 2D','Pusat Perbukuan, hlm. 1-17 dan hlm. 76-82. Cakupan meliputi organ ekskresi, nefron, urine, keseimbangan air, gangguan, dan pencegahan',{
    cp_target:'CP 1.1.3 / ATP 8.1.1.3: mendeskripsikan fungsi organ dan contoh gangguan pada sistem ekskresi.',
    learning_goals:['Membedakan ekskresi, sekresi, dan defekasi.','Menjelaskan fungsi ginjal, kulit, paru-paru, dan hati dalam pengeluaran zat sisa.','Mengurutkan pembentukan dan jalur urine.','Menjelaskan contoh gangguan tanpa melakukan diagnosis mandiri.'],
    glossary:[['Nefron','unit struktural dan fungsional ginjal'],['Filtrasi','penyaringan awal sebagian plasma darah'],['Reabsorpsi','penyerapan kembali zat yang masih diperlukan tubuh']],
    enrichment:'Gunakan model neraca air: catat secara kualitatif sumber air masuk dan keluar tubuh dalam satu hari, lalu jelaskan mengapa model tersebut tidak dapat menentukan kebutuhan medis seseorang.'
  }),
  'CH08-02-U06':material_([
    ['Rantai pasokan ke sel','Zat makanan diserap dari usus dan oksigen berdifusi dari alveolus. Darah mengantarkan keduanya ke sel untuk mendukung respirasi sel dan kegiatan tubuh.'],
    ['Rantai pembuangan','Karbon dioksida dibawa darah ke paru-paru. Hati mengolah berbagai zat, sedangkan ginjal mengatur air, ion, dan urea. Sistem pembuangan bergantung pada peredaran sebagai penghubung.'],
    ['Air dan pengaturan suhu','Air berpindah melalui pencernaan, darah, jaringan, ginjal, kulit, dan paru-paru. Saat panas atau beraktivitas, keringat membantu pelepasan panas; perubahan air tubuh dapat memengaruhi volume darah dan pembentukan urine.'],
    ['Aktivitas mengubah kebutuhan','Ketika berlari, otot menggunakan lebih banyak energi. Frekuensi napas dan denyut meningkat, aliran darah menyesuaikan, suhu naik, dan keringat dapat bertambah. Setelah berhenti, tubuh berangsur kembali menuju keadaan awal.'],
    ['Membaca kasus dengan bukti','Data frekuensi napas, denyut, suhu, asupan, urine, dan aktivitas dapat membantu menyusun penjelasan, tetapi tiap data memiliki keterbatasan. Lelah atau sesak dapat memiliki lebih dari satu penyebab sehingga kesimpulan harus berhati-hati.'],
    ['Kebiasaan dan banyak sistem','Makanan beragam, air cukup, aktivitas, tidur, kebersihan, dan kualitas udara memengaruhi beberapa sistem sekaligus. Upaya kesehatan yang baik mempertimbangkan hubungan sebab-akibat dan kondisi individu.'],
    ['Menyusun penjelasan ilmiah','Penjelasan yang kuat memuat pernyataan, bukti, dan alasan yang menghubungkan bukti dengan konsep. Jika bukti belum cukup, nyatakan keterbatasan dan data tambahan yang diperlukan.']
  ],'Pada dehidrasi, air tubuh berkurang. Volume darah dan pengaturan suhu dapat terpengaruh, sedangkan ginjal cenderung menghasilkan urine lebih sedikit dan lebih pekat untuk mempertahankan air.','Satu gejala tidak otomatis menunjuk satu organ tertentu. Hubungan antarsistem membantu menyusun kemungkinan, tetapi tidak menggantikan pemeriksaan kesehatan.','Buat peta hubungan minimal empat sistem ketika seseorang berlari, kemudian tulis satu klaim, dua bukti, dan alasan ilmiahnya.','Okky Fajar Tri Maryana dkk., Ilmu Pengetahuan Alam untuk SMP Kelas VIII (2021), Bab 2; Saeful Karim dkk., Belajar IPA 2 (2008), Bab 3-5; Dewi Ganawati dkk., IPA Terpadu IX (2008), Bab 1','Sintesis Pusat Perbukuan, hlm. 27-82, hlm. 37-82, dan hlm. 1-17. Hubungan antarsistem disusun untuk memenuhi analisis CP dan keterampilan proses ATP',{
    cp_target:'CP 1.1.3 / ATP 8.1.1.3: menganalisis hubungan struktur-fungsi, gangguan organ, data, dan bukti pada sistem tubuh.',
    learning_goals:['Menghubungkan pencernaan, pernapasan, peredaran, dan ekskresi.','Menjelaskan respons beberapa sistem saat aktivitas atau kekurangan air.','Menyusun penjelasan berbasis klaim, bukti, dan alasan.'],
    glossary:[['Respirasi sel','proses pelepasan energi dari zat makanan di dalam sel'],['Variabel','faktor yang dapat berubah dalam penyelidikan'],['Bukti','data atau pengamatan yang mendukung atau menolak suatu penjelasan']],
    enrichment:'Pilih kasus aktivitas fisik, kurang minum, atau paparan asap. Buat diagram sebab-akibat, tandai bukti yang tersedia, dan tulis data tambahan yang diperlukan. Pengayaan tidak memengaruhi kunci progres.'
  }),
  'CH08-03-U01':material_([
    ['Mengenali materi','Materi mempunyai massa dan menempati ruang. Sifat seperti wujud, warna, kelarutan, massa jenis, titik leleh, atau daya hantar dapat digunakan untuk mengenali bahan.'],
    ['Perubahan fisika','Perubahan fisika mengubah bentuk atau keadaan tanpa menghasilkan zat baru, misalnya es mencair atau gula larut.'],
    ['Perubahan kimia','Perubahan kimia menghasilkan zat dengan sifat baru. Petunjuknya dapat berupa pembentukan gas, endapan, perubahan warna, bau, atau perubahan suhu, tetapi bukti perlu ditafsirkan hati-hati.'],
    ['Manfaat mengenali sifat','Pengetahuan sifat bahan membantu memilih panci penghantar panas, wadah tahan korosi, bahan bangunan, cara penyimpanan, serta pemilahan sampah yang dapat digunakan kembali atau didaur ulang.']
  ],'Es yang mencair tetap tersusun atas air, sedangkan kertas terbakar menghasilkan abu dan gas dengan sifat berbeda.','Perubahan warna tidak selalu membuktikan reaksi kimia; pencampuran pewarna juga mengubah warna tanpa membentuk zat baru.','Kelompokkan lima perubahan di rumah menjadi fisika atau kimia dan tulis alasannya.','Anni Winarsih dkk., IPA Terpadu SMP/MTs Kelas VII (2008), Bab 7-8 Sifat Zat, Pemisahan Campuran, dan Perubahan Materi','Pusat Perbukuan Depdiknas, hlm. 145-180. Materi sifat dan perubahan berasal dari dua bab yang berdekatan'),
  'CH08-03-U02':material_([
    ['Unsur','Unsur adalah zat yang tidak dapat diuraikan menjadi zat lebih sederhana melalui reaksi kimia biasa. Setiap unsur memiliki lambang, misalnya Fe untuk besi dan O untuk oksigen.'],
    ['Senyawa','Senyawa tersusun atas dua atau lebih unsur yang berikatan dalam perbandingan tetap. Air murni tersusun atas hidrogen dan oksigen, tetapi sifat air berbeda dari kedua unsur tersebut.'],
    ['Partikel dan rumus','Rumus kimia menunjukkan jenis dan perbandingan atom penyusun. Rumus bukan gambar bentuk sebenarnya, melainkan bahasa ringkas untuk menyatakan komposisi.'],
    ['Konteks dan keselamatan','Label air mineral, garam, pupuk, obat, dan pembersih memuat nama atau lambang zat. Mengenali komposisi membantu penggunaan yang tepat, tetapi bahan tidak boleh dicicipi hanya untuk mengidentifikasinya.']
  ],'Garam dapur memiliki sifat berbeda dari natrium dan klorin penyusunnya karena telah terbentuk senyawa baru.','Senyawa bukan campuran yang kebetulan tercampur rata; pembentukannya melibatkan ikatan dan perbandingan tertentu.','Jelaskan perbedaan unsur dan senyawa dari penyusun, sifat, serta cara pemisahannya.','Okky Fajar Tri Maryana dkk., Ilmu Pengetahuan Alam untuk SMP Kelas VIII (2021), Bab 5A-B; Anni Winarsih dkk., IPA Terpadu VII (2008), Bab 3','Pusat Perbukuan, hlm. 125-158 dan hlm. 51-63. Materi memadukan klasifikasi lama dengan penjelasan partikel yang lebih mutakhir'),
  'CH08-03-U03':material_([
    ['Campuran','Campuran tersusun atas dua atau lebih zat tanpa membentuk zat baru. Komposisinya dapat berubah dan sifat dasar komponennya masih dapat dikenali.'],
    ['Homogen dan heterogen','Campuran homogen tampak seragam pada tingkat pengamatan biasa, seperti larutan garam. Campuran heterogen memiliki bagian yang dapat dibedakan, seperti pasir dalam air.'],
    ['Memilih pemisahan','Penyaringan memanfaatkan ukuran partikel, magnetisasi memanfaatkan sifat magnet, penguapan dan distilasi memanfaatkan perbedaan volatilitas, sedangkan kromatografi memanfaatkan perbedaan interaksi komponen.'],
    ['Manfaat pemisahan','Pemisahan digunakan pada pembuatan garam, penjernihan air, pemilahan logam, pemeriksaan tinta, pengolahan pangan, dan laboratorium. Hasil pemisahan harus dinilai sesuai tujuan, bukan hanya dari tampilannya.']
  ],'Air keruh dapat disaring untuk menahan partikel, tetapi hasil yang bening belum tentu aman diminum karena zat terlarut atau mikroorganisme mungkin masih ada.','Satu metode tidak cocok untuk semua campuran; pilih berdasarkan sifat komponen dan tujuan pemisahan.','Pilih metode untuk memisahkan pasir, garam, dan serbuk besi serta jelaskan urutannya.','Okky Fajar Tri Maryana dkk., Ilmu Pengetahuan Alam untuk SMP Kelas VIII (2021), Bab 5C; Anni Winarsih dkk., IPA Terpadu VII (2008), Bab 7','Pusat Perbukuan, hlm. 159-170 dan hlm. 145-157. Metode dipilih berdasarkan sifat komponen dan tujuan pemisahan'),
  'CH08-04-U01':material_([
    ['Lapisan berdasarkan sifat','Bumi dapat dimodelkan sebagai kerak, mantel, inti luar, dan inti dalam. Setiap lapisan berbeda ketebalan, komposisi, suhu, dan keadaan fisiknya.'],
    ['Bukti tidak langsung','Manusia belum menggali hingga inti. Informasi tentang bagian dalam bumi terutama diperoleh dari perilaku gelombang gempa, material vulkanik, sifat magnet, dan perhitungan massa jenis.'],
    ['Model selalu terbatas','Gambar berlapis membantu memahami susunan bumi, tetapi ketebalan dan batas pada ilustrasi biasanya tidak dibuat tepat menurut skala.'],
    ['Karakteristik utama','Kerak merupakan lapisan terluar dan paling tipis. Mantel sangat tebal dan sebagian batuannya dapat mengalir sangat lambat. Inti luar bersifat cair, sedangkan inti dalam tetap padat karena tekanan sangat besar.']
  ],'Seperti dokter membaca bagian dalam tubuh dengan gelombang, ilmuwan membaca bagian dalam bumi dari perubahan gelombang gempa.','Mantel bukan lautan magma cair seluruhnya; sebagian besar berupa batuan padat panas yang dapat berubah bentuk sangat lambat.','Gambar empat lapisan bumi dan tulis satu bukti yang digunakan ilmuwan untuk mempelajarinya.','Okky Fajar Tri Maryana dkk., Ilmu Pengetahuan Alam untuk SMP Kelas VIII (2021), Bab 6A Struktur Bumi','Pusat Perbukuan Kemendikbudristek, hlm. 171-187. Diagram digambar ulang dan tidak menggunakan skala ketebalan sebenarnya'),
  'CH08-04-U02':material_([
    ['Lempeng bergerak','Litosfer terpecah menjadi lempeng yang bergerak sangat lambat di atas lapisan yang lebih plastis. Geraknya dapat saling mendekat, menjauh, atau bergeser.'],
    ['Gempa dan patahan','Tegangan dapat menumpuk pada batuan di sekitar batas lempeng. Ketika batuan bergeser mendadak, energi dilepaskan sebagai gelombang gempa.'],
    ['Risiko bukan hanya kekuatan','Dampak gempa dipengaruhi kedalaman, jarak, kondisi tanah, kualitas bangunan, kepadatan penduduk, dan kesiapsiagaan. Bahaya alam menjadi bencana ketika bertemu kerentanan.'],
    ['Batas lempeng dan Indonesia','Batas konvergen saling mendekat, divergen saling menjauh, dan transform saling bergeser. Indonesia berada dekat pertemuan beberapa lempeng sehingga gempa dan pembentukan pegunungan aktif perlu dipahami bersama mitigasinya.']
  ],'Dua kota dapat merasakan dampak berbeda dari gempa yang sama karena kondisi tanah dan bangunannya berbeda.','Lempeng tidak bergerak cepat setiap hari; pergeserannya lambat, tetapi energi yang terkumpul dapat dilepas mendadak.','Jelaskan beda pusat gempa, episentrum, bahaya, kerentanan, dan risiko.','Okky Fajar Tri Maryana dkk., Ilmu Pengetahuan Alam untuk SMP Kelas VIII (2021), Bab 6B-C Lempeng Tektonik dan Gempa Bumi','Pusat Perbukuan Kemendikbudristek, hlm. 188-207. Langkah mitigasi diselaraskan dengan panduan kebencanaan pemerintah'),
  'CH08-04-U03':material_([
    ['Magma dan erupsi','Batuan cair di bawah permukaan disebut magma. Ketika material keluar ke permukaan, bagian cairnya disebut lava. Gas, kekentalan magma, dan kondisi saluran memengaruhi sifat erupsi.'],
    ['Bahaya dan manfaat','Erupsi dapat menghasilkan abu, aliran piroklastik, lava, gas, dan lahar. Di sisi lain, material vulkanik dapat menyuburkan tanah serta menyediakan sumber mineral dan energi panas bumi.'],
    ['Mitigasi','Pemantauan, peta kawasan rawan, informasi resmi, latihan evakuasi, perlindungan pernapasan, dan kepatuhan pada zona bahaya membantu mengurangi risiko.'],
    ['Membaca informasi resmi','Status gunung api dan rekomendasi dapat berubah sesuai hasil pemantauan. Saat terjadi aktivitas, ikuti informasi PVMBG, BPBD, atau pemerintah setempat dan jangan menentukan jarak aman hanya dari pengamatan pribadi.']
  ],'Hujan dapat menggerakkan endapan abu dan material vulkanik menjadi lahar meskipun erupsi utama sudah berhenti.','Campuran soda kue dan asam hanya memodelkan pembentukan gas; model itu tidak sama dengan suhu, tekanan, dan komposisi magma nyata.','Susun tiga tindakan sebelum, saat, dan setelah erupsi berdasarkan sumber resmi.','Okky Fajar Tri Maryana dkk., Ilmu Pengetahuan Alam untuk SMP Kelas VIII (2021), Bab 6D Gunung Berapi; Badan Geologi, MAGMA Indonesia','Pusat Perbukuan Kemendikbudristek, hlm. 208-222. Informasi keselamatan operasional harus mengikuti rekomendasi resmi terbaru, bukan buku semata'),
  'CH08-05-U01':material_([
    ['Makna usaha','Dalam fisika, gaya melakukan usaha jika menyebabkan perpindahan dan memiliki komponen searah perpindahan. Untuk gaya searah, W = F x s.'],
    ['Besaran dan satuan','Gaya diukur dalam newton, perpindahan dalam meter, dan usaha dalam joule. Tuliskan diketahui, ditanya, rumus, substitusi, serta satuan.'],
    ['Tanda dan arah','Usaha dapat positif ketika gaya mendukung gerak, negatif ketika melawan gerak, atau nol jika tidak ada perpindahan maupun gaya tegak lurus perpindahan.'],
    ['Contoh hitungan bertahap','Diketahui F = 25 N dan s = 4 m searah gaya. Ditanya W. Gunakan W = F x s = 25 x 4 = 100 J. Hasil selalu ditulis bersama satuannya.']
  ],'Mendorong dinding yang tidak berpindah dapat melelahkan tubuh, tetapi usaha mekanis pada dinding bernilai nol.','Dalam bahasa sehari-hari usaha berarti ikhtiar; dalam fisika istilah itu mempunyai syarat gaya dan perpindahan.','Hitung usaha oleh gaya 25 N yang memindahkan benda 4 m searah gaya.','Saeful Karim dkk., Belajar IPA: Membuka Cakrawala Alam Sekitar 2 (2008), Bab 10; Okky Fajar Tri Maryana dkk., IPA VIII (2021), Bab 3A','Pusat Perbukuan, hlm. 183-204 dan hlm. 83-86. Contoh disusun dengan pola diketahui-ditanya-rumus-substitusi-satuan'),
  'CH08-05-U02':material_([
    ['Energi kinetik','Energi kinetik adalah energi karena gerak. Besarnya Ek = 1/2 m v^2, sehingga pengaruh kecepatan lebih kuat daripada pengaruh massa.'],
    ['Energi potensial gravitasi','Dekat permukaan bumi, energi potensial gravitasi dapat dihitung Ep = m g h. Nilainya bergantung pada titik acuan ketinggian.'],
    ['Perubahan energi mekanis','Ketika benda jatuh, energi potensial berkurang dan energi kinetik bertambah. Jika gesekan kecil, jumlah keduanya mendekati tetap.'],
    ['Contoh hitungan bertahap','Untuk m = 2 kg dan v = 4 m/s, Ek = 1/2 x 2 x 4^2 = 16 J. Untuk m = 3 kg, g = 10 m/s^2, dan h = 2 m, Ep = 3 x 10 x 2 = 60 J.']
  ],'Sepeda yang melaju dua kali lebih cepat memiliki energi kinetik empat kali lebih besar jika massanya tetap.','Energi bukan benda yang tersimpan dalam wadah; energi adalah besaran yang membantu menjelaskan kemampuan menghasilkan perubahan.','Bandingkan pengaruh menggandakan massa dan menggandakan kecepatan terhadap energi kinetik.','Saeful Karim dkk., Belajar IPA: Membuka Cakrawala Alam Sekitar 2 (2008), Bab 10; Okky Fajar Tri Maryana dkk., IPA VIII (2021), Bab 3B','Pusat Perbukuan, hlm. 183-204 dan hlm. 87-92. Perhitungan menggunakan satuan SI dan g = 10 m/s^2 untuk latihan dasar'),
  'CH08-05-U03':material_([
    ['Transformasi energi','Energi dapat berubah bentuk: kimia menjadi gerak dan panas, listrik menjadi cahaya, atau potensial menjadi kinetik. Dalam sistem tertutup, energi total tidak diciptakan atau dimusnahkan.'],
    ['Daya','Daya menyatakan laju melakukan usaha atau memindahkan energi. P = W/t, dengan satuan watt atau joule per sekon.'],
    ['Efisiensi nyata','Alat tidak mengubah seluruh energi masukan menjadi keluaran yang diinginkan. Efisiensi = energi berguna / energi masukan x 100 persen; sisanya berubah menjadi panas, bunyi, atau bentuk lain.'],
    ['Contoh hitungan bertahap','Jika W = 600 J dilakukan selama t = 5 s, maka P = W/t = 600/5 = 120 W. Jika keluaran berguna 480 J dari masukan 600 J, efisiensinya 480/600 x 100 persen = 80 persen.']
  ],'Dua siswa menaiki tangga yang sama dapat melakukan usaha hampir sama, tetapi siswa yang lebih cepat menghasilkan daya lebih besar.','Energi yang tidak menjadi keluaran berguna bukan hilang; energinya berubah dan menyebar ke lingkungan.','Buat diagram perubahan energi pada kipas listrik dan hitung daya jika 600 J digunakan selama 5 s.','Okky Fajar Tri Maryana dkk., Ilmu Pengetahuan Alam untuk SMP Kelas VIII (2021), Bab 3; Setya Nurachmandani dan Samson, IPA Terpadu VIII (2009), Energi dan Usaha','Pusat Perbukuan, hlm. 83-92; pembahasan efisiensi dirujuk pada hlm. 252 buku BSE IPA Terpadu VIII. Contoh hitungan disusun ulang'),
  'CH08-06-U01':material_([
    ['Getaran','Getaran adalah gerak bolak-balik melalui titik keseimbangan. Satu getaran penuh kembali ke posisi dan arah gerak awal.'],
    ['Frekuensi dan periode','Frekuensi adalah banyak getaran tiap sekon: f = n/t. Periode adalah waktu tiap getaran: T = t/n. Keduanya berhubungan T = 1/f.'],
    ['Amplitudo','Amplitudo adalah simpangan maksimum dari titik keseimbangan. Amplitudo tidak sama dengan jarak total yang ditempuh selama satu getaran.'],
    ['Contoh hitungan bertahap','Untuk n = 30 getaran selama t = 15 s, f = n/t = 2 Hz. Periodenya T = t/n = 0,5 s. Periksa kembali bahwa f x T = 1.']
  ],'Ayunan yang melakukan 20 getaran dalam 10 sekon memiliki frekuensi 2 Hz dan periode 0,5 sekon.','Getaran cepat berarti frekuensi besar dan periode kecil, bukan keduanya sama-sama besar.','Tentukan frekuensi dan periode dari 30 getaran selama 15 sekon.','Saeful Karim dkk., Belajar IPA: Membuka Cakrawala Alam Sekitar 2 (2008), Bab 12; Okky Fajar Tri Maryana dkk., IPA VIII (2021), Bab 4A','Pusat Perbukuan, hlm. 237-250 dan hlm. 103-107. Contoh menggunakan hubungan f = n/t, T = t/n, dan T = 1/f'),
  'CH08-06-U02':material_([
    ['Gelombang membawa energi','Gelombang adalah gangguan yang merambat. Partikel medium bergetar di sekitar kedudukannya, sedangkan energi gangguan berpindah.'],
    ['Jenis gelombang','Pada gelombang transversal arah getar tegak lurus arah rambat; pada gelombang longitudinal arah getar sejajar arah rambat. Gelombang mekanik memerlukan medium.'],
    ['Panjang dan cepat rambat','Panjang gelombang adalah jarak dua titik sefase berurutan. Hubungan cepat rambat, panjang gelombang, dan frekuensi adalah v = lambda x f.'],
    ['Contoh hitungan bertahap','Untuk panjang gelombang 1,5 m dan frekuensi 4 Hz, v = lambda x f = 1,5 x 4 = 6 m/s. Pastikan panjang memakai meter dan frekuensi memakai hertz.']
  ],'Gabus di permukaan air naik-turun ketika gelombang lewat dan tidak ikut berpindah sejauh gelombangnya.','Gelombang memindahkan energi, bukan memindahkan seluruh medium bersama-sama dari sumber ke tujuan.','Hitung cepat rambat gelombang dengan panjang 1,5 m dan frekuensi 4 Hz.','Saeful Karim dkk., Belajar IPA: Membuka Cakrawala Alam Sekitar 2 (2008), Bab 12; Okky Fajar Tri Maryana dkk., IPA VIII (2021), Bab 4B','Pusat Perbukuan, hlm. 237-250 dan hlm. 108-114. Notasi lambda dijelaskan sebagai panjang satu pola gelombang'),
  'CH08-06-U03':material_([
    ['Sumber dan perambatan bunyi','Bunyi berasal dari benda bergetar dan memerlukan medium. Karena ruang hampa tidak memiliki partikel medium, bunyi tidak merambat di sana.'],
    ['Nada dan kuat bunyi','Tinggi nada terutama berkaitan dengan frekuensi, sedangkan kuat-lemah bunyi berkaitan dengan amplitudo dan energi yang sampai ke pendengar.'],
    ['Pantulan dan resonansi','Pantulan bunyi dimanfaatkan pada sonar dan pengukuran jarak. Resonansi terjadi ketika suatu benda menerima getaran dengan frekuensi yang sesuai sehingga amplitudonya membesar.'],
    ['Contoh hitungan pantulan','Jika bunyi pantul kembali dalam 2 s dan cepat rambat bunyi 340 m/s, jarak bidang pantul = v x t / 2 = 340 x 2 / 2 = 340 m. Pembagian dua diperlukan karena bunyi menempuh perjalanan pergi dan pulang.'],
    ['Pemanfaatan dan kesehatan','Sonar, ultrasonografi, alat musik, dan pengukuran jarak memanfaatkan sifat bunyi. Paparan bunyi sangat keras atau terlalu lama dapat merusak pendengaran; kecilkan volume dan beri jarak atau waktu istirahat.']
  ],'Suara kereta dapat lebih dahulu terdengar melalui rel karena bunyi merambat dengan cara berbeda pada zat padat dan udara.','Nada tinggi tidak selalu lebih keras; tinggi nada dan kuat bunyi menggambarkan sifat yang berbeda.','Jelaskan perbedaan frekuensi, amplitudo, nada, dan kuat bunyi menggunakan satu contoh alat musik.','Saeful Karim dkk., Belajar IPA: Membuka Cakrawala Alam Sekitar 2 (2008), Bab 13 Bunyi','Pusat Perbukuan Depdiknas, hlm. 255-270. Materi mencakup sumber, medium, karakter bunyi, resonansi, pemantulan, manfaat, dan perlindungan pendengaran')
});

