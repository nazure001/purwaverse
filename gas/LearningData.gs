  mixture:{labels:['larutan','campuran','pemisah','hasil'],caption:'Metode pemisahan dipilih berdasarkan perbedaan ukuran partikel, kelarutan, titik didih, atau sifat fisika lain.'},
  earth:{labels:['kerak','mantel','inti','gelombang'],caption:'Penampang lapisan bumi dan gelombang gempa sebagai bukti; ketebalan tidak digambar menurut skala.'},
  tectonic:{labels:['konvergen','divergen','transform','risiko'],caption:'Tiga pola gerak relatif lempeng membentuk gejala geologi dan risiko yang berbeda.'},
  volcano:{labels:['magma','kawah','bahaya','mitigasi'],caption:'Model gunung api menghubungkan bagian, bahaya, dan tindakan mitigasi; bentuk erupsi nyata dapat berbeda.'},
  work:{labels:['gaya F','jarak s','usaha W','data'],caption:'Usaha untuk gaya searah perpindahan dihitung dengan W = F x s berdasarkan data terukur.'},
  energy:{labels:['massa m','kecepatan v','tinggi h','perubahan'],caption:'Gerak berkaitan dengan energi kinetik, sedangkan posisi berkaitan dengan energi potensial gravitasi.'},
  power:{labels:['energi','waktu t','daya P','efisiensi'],caption:'Daya membandingkan usaha atau energi terhadap waktu; efisiensi membandingkan keluaran berguna dengan masukan.'},
  vibration:{labels:['simpangan','amplitudo','periode','frekuensi'],caption:'Ayunan menunjukkan simpangan terhadap titik seimbang serta pola getaran berulang.'},
  wave:{labels:['amplitudo','lambda','frekuensi','sifat'],caption:'Gelombang memindahkan energi dan dapat mengalami pemantulan, pembiasan, serta perubahan pola.'},
  sound:{labels:['sumber','medium','pantulan','pendengar'],caption:'Bunyi berasal dari getaran, merambat melalui medium, dan dapat dipantulkan sebelum mencapai pendengar.'}
});

function learningIllustration_(key){
  const labels={cell:['SEL','unit kehidupan'],organelles:['ORGANEL','struktur dan fungsi'],hierarchy:['ORGANISASI','sel hingga organisme'],body:['TUBUH','sistem terhubung'],digestion:['PENCERNAAN','jalur dan penyerapan'],circulation:['PEREDARAN','jantung dan pembuluh'],respiration:['PERNAPASAN','ventilasi dan pertukaran gas'],excretion:['EKSKRESI','mengatur dan membuang sisa'],systems:['ANTARSISTEM','pasokan, penggunaan, sisa'],matter:['MATERI','sifat dan perubahan'],element:['UNSUR & SENYAWA','atom dan komposisi'],mixture:['CAMPURAN','pemisahan berdasar sifat'],earth:['STRUKTUR BUMI','lapisan dan bukti'],tectonic:['LEMPENG','gerak, gempa, risiko'],volcano:['GUNUNG API','magma dan mitigasi'],work:['USAHA','gaya dan perpindahan'],energy:['ENERGI','gerak dan posisi'],power:['DAYA','energi setiap waktu'],vibration:['GETARAN','frekuensi dan periode'],wave:['GELOMBANG','panjang dan cepat rambat'],sound:['BUNYI','getaran dalam medium']};
  const x=labels[key]||['SAINS','amati dan buktikan'],meta=LEARNING_ILLUSTRATION_META_[key]||{labels:['amati','jelaskan','buktikan','simpulkan'],caption:'Diagram konsep untuk membantu membaca materi.'};
  const legend=meta.labels.slice(0,4).map((label,i)=>{const col=i%2,row=Math.floor(i/2),left=452+col*126,top=186+row*29;return '<g><rect x="'+left+'" y="'+top+'" width="116" height="24" rx="12" fill="#ffffff1f"/><text x="'+(left+58)+'" y="'+(top+17)+'" text-anchor="middle" fill="#fff" font-size="11">'+label+'</text></g>';}).join('');
  return '<figure class="science-figure"><svg class="science-illustration" viewBox="0 0 720 250" role="img" aria-label="Diagram '+x[0]+'"><defs><linearGradient id="g-'+key+'" x1="0" x2="1"><stop stop-color="#172554"/><stop offset="1" stop-color="#4338ca"/></linearGradient></defs><rect width="720" height="250" rx="30" fill="url(#g-'+key+')"/><text x="44" y="73" fill="#fff" font-size="30" font-weight="800">'+x[0]+'</text><text x="44" y="108" fill="#dbeafe" font-size="19">'+x[1]+'</text>'+learningDiagram_(key)+legend+'</svg><figcaption>'+meta.caption+' <span>Diagram adaptasi berdasarkan sumber materi; bukan skala sebenarnya.</span></figcaption></figure>';
}

