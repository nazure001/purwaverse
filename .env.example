# ==============================================================================
# PURWAVERSE LMS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin berkas ini menjadi .env pada direktori server/ atau root deployment VPS.
# PENTING: DILARANG memasukkan credential rahasia asli ke dalam file ini atau git!
#
# Status Penandaan Key:
# [ACTIVE]             : Dibaca dan digunakan langsung oleh runtime saat ini.
# [COMPATIBILITY_ONLY] : Digunakan sebagai referensi konfigurasi Nginx / fallback legacy.
# [TEST_ONLY]          : HANYA untuk pengetesan lokal/CI terisolasi (wajib kosong di VPS).
# [FUTURE_UNUSED]      : Disediakan untuk rilis mendatang, belum diaktifkan di runtime.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME & SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# [ACTIVE] Mode runtime: 'production', 'staging', atau 'development'
NODE_ENV=production

# [ACTIVE] Port internal backend Express
PORT=3000

# [ACTIVE] Pengaturan Trust Proxy untuk reverse proxy Nginx (1, true, atau hop count)
TRUST_PROXY=1

# [ACTIVE] Daftar domain yang diizinkan mengakses API (CORS). Pisahkan koma jika jamak.
# Pada staging / production, dilarang menggunakan wildcard '*'!
ALLOWED_ORIGIN=https://staging.purwaverse.sekolah.sch.id

# [COMPATIBILITY_ONLY] URL publik aplikasi (referensi reverse proxy / Nginx)
BASE_URL=https://staging.purwaverse.sekolah.sch.id

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (SQLite WAL Mode)
# ------------------------------------------------------------------------------
# [ACTIVE] Path absolut atau relatif ke file basis data SQLite
# Catatan Staging: Wajib menggunakan nama 'purwaverse_staging.db'
DB_PATH=/var/www/purwaverse/data/purwaverse_staging.db

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
# [ACTIVE] Durasi masa aktif sesi pengguna dalam satuan jam (default: 8)
SESSION_TTL_HOURS=8

# [FUTURE_UNUSED] Kunci rahasia cadangan jika migrasi ke token JWT stateless di masa mendatang
JWT_SECRET=replace-with-a-cryptographically-secure-random-string-min-32-chars

# [COMPATIBILITY_ONLY] Pepper kompatibilitas untuk memverifikasi PIN berformat SHA-256 lama sebelum hash otomatis ditingkatkan menjadi Argon2id
STUDENT_PIN_PEPPER=replace-with-secure-uuid-or-pepper-string

# [ACTIVE] Akun pengguna guru utama (default: guru)
TEACHER_USERNAME=guru

# [ACTIVE] Kata sandi guru dalam bentuk hash Argon2id (wajib diisi pada staging/produksi)
# Generate hash via: node -e "require('argon2').hash('YourStrongPassword').then(console.log)"
TEACHER_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$dummySaltString$dummyHashStringExampleForStagingOnly

# [COMPATIBILITY_ONLY] Salt opsional jika menggunakan fallback hash SHA-256 legacy
TEACHER_PASSWORD_SALT=replace-with-salt-string-if-using-sha256-fallback

# [ACTIVE] Daftar kelas yang diampu guru, dipisahkan koma
TEACHER_CLASSES=8A,8B,8C,8D,8E

# [TEST_ONLY] Kata sandi developer untuk test lokal otomatis.
# PERINGATAN KERAS: WAJIB KOSONG pada server Staging dan Produksi!
TEACHER_DEV_PASSWORD=

# ------------------------------------------------------------------------------
# 4. APPLICATION & ACADEMIC POLICY CONFIGURATION
# ------------------------------------------------------------------------------
# [ACTIVE] Nama aplikasi pada header antarmuka
APP_NAME=Purwaverse IPA VIII

# [ACTIVE] Mode aplikasi (misal: VPS-STAGING atau VPS-PRODUCTION)
APP_MODE=VPS-STAGING

# [ACTIVE] Tahun ajaran aktif untuk master kelas
SCHOOL_YEAR=2026/2027

# [ACTIVE] Semester aktif untuk penyaringan modul (1 atau 2)
CURRENT_SEMESTER=1

# [ACTIVE] Kriteria Ketuntasan Minimal (KKM) untuk kuis penguasaan
QUIZ_PASSING_SCORE=70

# [FUTURE_UNUSED] Nomor kontak WhatsApp guru untuk tautan bantuan siswa di footer UI
TEACHER_WA_NUMBER=080000000000

# ------------------------------------------------------------------------------
# 5. LOGGING & PROCESS CONFIGURATION
# ------------------------------------------------------------------------------
# [FUTURE_UNUSED] Level filter logger (runtime saat ini memakai console terstruktur)
LOG_LEVEL=info

# [COMPATIBILITY_ONLY] Direktori penyimpanan file log PM2 / systemd di server Linux
LOG_DIR=/var/log/purwaverse
